# Requested 10 warm tabs: XX88x2, MM88x2, RR88x1, GG88x2, O8x1, QQ88x1, HI88x1
TAB_POOL_SIZE=2
MAX_TAB_PER_DOMAIN_CAP=2
TAB_POOL_MIN_TABS_PER_DOMAIN=1
TAB_POOL_IDLE_TTL=86400
TAB_POOL_MEMORY_COMPACT_IDLE_SECONDS=120
TAB_POOL_MEMORY_RELOAD_IDLE_SECONDS=600
TAB_ACQUIRE_WAIT_SECONDS=15.0

# Low-RAM submit limits: tabs stay warm; only 4 submits run at once
MAX_CONCURRENT_SUBMITS=8
MAX_CONCURRENT_SUBMITS_PER_DOMAIN=2
SUBMIT_TIMEOUT_SECONDS=45
PAGE_NAVIGATION_TIMEOUT=15000
FORM_SETTLE_SECONDS=0.03

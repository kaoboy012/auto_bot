# Durable inbox
TELEGRAM_INBOX_DB_PATH=data/telegram_inbox.db
TELEGRAM_INBOX_LEASE_SECONDS=300
MAX_INBOX_ATTEMPTS=5
INBOX_RETRY_BASE_DELAY=2
INBOX_RETRY_MAX_DELAY=120

# Telegram ingest / processing
CHANNEL_FETCH_WORKERS=2
MESSAGE_WORKERS=4
OCR_MEDIA_WORKERS=2

# Browser / submit concurrency
TAB_POOL_SIZE=2
MAX_TAB_PER_DOMAIN_CAP=5
MAX_CONCURRENT_SUBMITS=8
MAX_CONCURRENT_SUBMITS_PER_DOMAIN=2

# Fast browser hot path
# false = keep background-tab path (fastest); true = foreground Edge before each submit
# Use true only for sites/widgets that require visible tab state.
WAKE_TAB_ON_SUBMIT=false
PRESERVE_PREFILLED_USERNAME=true
RESULT_SELECTOR_FAST_WINDOW_SECONDS=0.15
RESULT_SNAPSHOT_MAX_CHARS=30000
RESULT_POLL_INTERVAL=0.05
RESULT_DETECTION_TIMEOUT=5000

# Edge CDP
EDGE_CDP_HOST=127.0.0.1
EDGE_CDP_PORT=9222

# Turnstile (QQ88/HI88): chờ có giới hạn rồi bấm "Xác thực" ngay trong lượt gửi (0 = tắt)
PENDING_INLINE_WAIT_SECONDS=6

# Tab: không đóng tab phụ khi rảnh (giữ tab thứ 2 nóng cho domain 2 tài khoản)
TAB_POOL_IDLE_TTL=86400

# Poll Telegram: timeout ngắn để không "mù" 5s mỗi request treo
CHANNEL_POLL_REQUEST_TIMEOUT=2.0
CHANNEL_POLL_INTERVAL=0.5

# Hàng đợi
MESSAGE_QUEUE_MAXSIZE=2000
OCR_MEDIA_QUEUE_MAXSIZE=32

# Admin / cảnh báo (tuỳ chọn)

# Low-RAM profile for the requested 10 warm tabs.
# Merge these overrides into the production .env; do not replace secrets/session/database values.

# Keep exactly the requested warm-tab ceiling:
TAB_POOL_SIZE=2
MAX_TAB_PER_DOMAIN_CAP=2
TAB_POOL_MIN_TABS_PER_DOMAIN=2
AUTO_OPEN_MISSING_TABS=true

# Keep pages warm but compact/reload idle pages more often.
TAB_POOL_IDLE_TTL=86400
TAB_POOL_MEMORY_COMPACT_IDLE_SECONDS=120
TAB_POOL_MEMORY_RELOAD_IDLE_SECONDS=600
FULL_RELOAD_EVERY_N=50

# Low-RAM browser concurrency: 10 tabs remain open, but only 4 submit at once.
MAX_CONCURRENT_SUBMITS=4
MAX_CONCURRENT_SUBMITS_PER_DOMAIN=1
TAB_ACQUIRE_WAIT_SECONDS=5
SUBMIT_TIMEOUT_SECONDS=40
MAX_RETRIES_PER_ACCOUNT=1
RETRY_ON_TIMEOUT=true

# Telegram and processing backpressure.
MESSAGE_WORKERS=2
MAX_CONCURRENT_PROCESSING=8
MAX_CONCURRENT_INGRESS_TASKS=32
MESSAGE_QUEUE_MAXSIZE=500
DOMAIN_QUEUE_MAXSIZE=200
TELEGRAM_INBOX_DRAIN_BATCH=100
TELEGRAM_INBOX_DRAIN_INTERVAL=0.25

# OCR/media: one inference and two downloads at a time.
MAX_CONCURRENT_OCR=1
MAX_CONCURRENT_MEDIA_DOWNLOADS=2
FAST_DOWNLOAD_WORKERS=3
FAST_DOWNLOAD_CHUNK_KB=256
OCR_MAX_IMAGE_SIDE=1024
OCR_DET_LIMIT_SIDE=512
VIDEO_OCR_MAX_FRAMES=2
OCR_CACHE_MAX_ENTRIES=64
PAUSE_OCR_ON_HIGH_CPU=true
OCR_CPU_THRESHOLD=80
OCR_RAM_WARN_THRESHOLD=80
OCR_RAM_PAUSE_THRESHOLD=88

# Retry/backlog limits.
MAX_INBOX_ATTEMPTS=4
INBOX_RETRY_BASE_DELAY=3
INBOX_RETRY_MAX_DELAY=60
QUEUE_SOFT_LIMIT_PCT=0.70
QUEUE_HARD_LIMIT_PCT=0.90
QUEUE_CLEANUP_ON_SOFT_LIMIT=false

# CDP health/reconnect checks; CDP must remain loopback-only.
EDGE_CDP_HOST=127.0.0.1
EDGE_CDP_PORT=9222
CDP_PING_INTERVAL=30
EDGE_CDP_WATCHDOG_INTERVAL=5

# Result detection: keep site-specific values from production unless logs prove a site is slower.
RESULT_POLL_INTERVAL=0.10
RESULT_SELECTOR_FAST_WINDOW_SECONDS=0.80
SCREENSHOT_ON_UNKNOWN=false
